cker, df in all_data.items():\n","    assert isinstance(df, pd.DataFrame)\n","    assert isinstance(df.index, pd.DatetimeIndex)\n","    assert df.index.name == \"date\"\n","    assert df.columns.to_list() == [\"open\", \"high\", \"low\", \"close\", \"volume\"]\n","    assert all(df.dtypes == float)\n","\n","print(\"All\", len(all_data), \"assets retrieved and validated.\")\n","all_data[\"BTC-USD\"].head()\n"]},{"cell_type":"markdown","id":"61e90da1","metadata":{"papermill":{"duration":0.009183,"end_time":"2026-10-22T17:49:59.45431+00:00","exception":false,"start_time":"2026-10-22T17:49:59.445127+00:00","status":"completed"},"tags":[]},"source":["## Step 3: Data Storage and Returns\n","The collected data is stored in a shared SQLite database, one table per asset, so later steps can read it back without calling the API again. Daily returns are then computed from the stored closing prices."]},{"cell_type":"code","execution_count":9,"id":"ecbfc0d9","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:49:59.474224Z","iopub.status.busy":"2026-10-22T17:49:59.473894Z","iopub.status.idle":"2026-10-22T17:49:59.480824Z","shell.execute_reply":"2026-10-22T17:49:59.479903Z"},"papermill":{"duration":0.019017,"end_time":"2026-10-22T17:49:59.482438+00:00","exception":false,"start_time":"2026-10-22T17:49:59.463421+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# Database access layer shared by every asset\n","class SQLRepository:\n","    \"\"\"Store and retrieve asset data in a SQLite database.\n","\n","    Args:\n","        connection: Open SQLite connection.\n","    \"\"\"\n","\n","    def __init__(self, connection: sqlite3.Connection):\n","        self.connection = connection\n","\n","    def insert_table(self, table_name: str, records: pd.DataFrame, if_exists: str = \"fail\") -> dict:\n","        \"\"\"Insert a DataFrame into the database as a table.\n","\n","        Args:\n","            table_name: Name of the table to create.\n","            records: DataFrame to store.\n","            if_exists: What to do when the table exists: \"fail\", \"replace\" or \"append\".\n","\n","        Returns:\n","            Dict with \"transaction_successful\" (bool) and \"records_inserted\" (int).\n","        \"\"\"\n","        n_inserted = records.to_sql(\n","            name=table_name, con=self.connection, if_exists=if_exists\n","        )\n","        return {\n","            \"transaction_successful\": True,\n","            \"records_inserted\": n_inserted,\n","        }\n","\n","    def read_table(self, table_name: str, limit: int = None) -> pd.DataFrame:\n","        \"\"\"Read a table back from the database.\n","\n","        Args:\n","            table_name: Name of the table to read.\n","            limit: Number of most recent rows to return. None returns all rows.\n","\n","        Returns:\n","            DataFrame with a DatetimeIndex named \"date\" and the columns open, high,\n","            low, close and volume.\n","        \"\"\"\n","        if limit:\n","            sql = f'SELECT * FROM \"{table_name}\" ORDER BY date DESC LIMIT {limit}'\n","        else:\n","            sql = f'SELECT * FROM \"{table_name}\"'\n","\n","        df = pd.read_sql(sql=sql, con=self.connection, parse_dates=[\"date\"], index_col=\"date\")\n","        return df"]},{"cell_type":"code","execution_count":10,"id":"a9f24f5b","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:49:59.502434Z","iopub.status.busy":"2026-10-22T17:49:59.502072Z","iopub.status.idle":"2026-10-22T17:49:59.50777Z","shell.execute_reply":"2026-10-22T17:49:59.50692Z"},"papermill":{"duration":0.017904,"end_time":"2026-10-22T17:49:59.509508+00:00","exception":false,"start_time":"2026-10-22T17:49:59.491604+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["repo type: <class '__main__.SQLRepository'>\n"]}],"source":["# Connect to the SQLite database and wrap it in the repository\n","connection = sqlite3.connect(datab