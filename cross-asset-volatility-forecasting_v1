"image/png":"\n","text/plain":["<Figure size 1500x400 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1500x400 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1500x400 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# PACF of squared returns\n","for ticker in all_tickers:\n","    fig, ax = plt.subplots(figsize=(15, 4))\n","    plot_pacf(returns_data[ticker] ** 2, ax=ax)\n","    ax.set_title(f\"{ticker}: PACF of Squared Returns\")\n","    ax.set_xlabel(\"Lag [days]\")\n","    ax.set_ylabel(\"Correlation Coefficient\")\n","    plt.show()"]},{"cell_type":"markdown","id":"13a07d85","metadata":{"papermill":{"duration":0.023322,"end_time":"2026-10-22T17:50:07.455078+00:00","exception":false,"start_time":"2026-10-22T17:50:07.431756+00:00","status":"completed"},"tags":[]},"source":["## Step 5: Train/Test Split\n","The first 80% of each asset's returns is used for fitting and the last 20% is held out for walk forward validation. The split is chronological, so no future data reaches the training set."]},{"cell_type":"code","execution_count":25,"id":"2d087ed7","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:07.502024Z","iopub.status.busy":"2026-10-22T17:50:07.501699Z","iopub.status.idle":"2026-10-22T17:50:07.508399Z","shell.execute_reply":"2026-10-22T17:50:07.507443Z"},"papermill":{"duration":0.032467,"end_time":"2026-10-22T17:50:07.510141+00:00","exception":false,"start_time":"2026-10-22T17:50:07.477674+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["AAPL: train=(1003,), test=(251,)\n","JPM: train=(1003,), test=(251,)\n","XOM: train=(1003,), test=(251,)\n","BTC-USD: train=(1460,), test=(366,)\n","ETH-USD: train=(1460,), test=(366,)\n","SOL-USD: train=(1460,), test=(366,)\n"]}],"source":["# Chronological 80/20 split per asset\n","train_returns = {}\n","test_returns = {}\n","\n","for ticker in all_tickers:\n","    cutoff = int(len(returns_data[ticker]) * 0.8)\n","    train_returns[ticker] = returns_data[ticker].iloc[:cutoff]\n","    test_returns[ticker] = returns_data[ticker].iloc[cutoff:]\n","    print(f\"{ticker}: train={train_returns[ticker].shape}, test={test_returns[ticker].shape}\")"]},{"cell_type":"markdown","id":"e7fe1da7","metadata":{"papermill":{"duration":0.022762,"end_time":"2026-10-22T17:50:07.555478+00:00","exception":false,"start_time":"2026-10-22T17:50:07.532716+00:00","status":"completed"},"tags":[]},"source":["## Step 6: GARCH Modelling\n","A reusable modelling class supports GARCH(1,1), EGARCH(1,1) and GJR-GARCH(1,1). All three specifications are fitted to every asset on its training returns, giving 18 models in total (6 assets and 3 specifications) stored in a nested dictionary."]},{"cell_type":"code","execution_count":26,"id":"75fb3c29","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:07.604306Z","iopub.status.busy":"2026-10-22T17:50:07.603974Z","iopub.status.idle":"2026-10-22T17:50:07.611349Z","shell.execute_reply":"2026-10-22T17:50:07.610577Z"},"papermill":{"duration":0.032986,"end_time":"2026-10-22T17:50:07.613096+00:00","exception":false,"start_time":"2026-10-22T17:50:07.58011+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class GarchModel:\n","    \"\"\"Fit and store a GARCH family volatility model for one asset.\n","\n","    Args:\n","        ticker: Asset ticker.\n","        data: Training returns series.\n","    \"\"\"\n","    def __init__(self, ticker: str, data: pd.Series):\n","        self.ticker = ticker\n","        self.data = data  # training returns\n","\n","    def fit(self, p: int=1, q: int=1, vol_model: str = \"GARCH\") -> ARCHModelResult:\n","        \"\"\"Fit a GARCH family model to the training returns.\n","\n","        Args:\n","            p: Lag order of the symmetric innovations (the ARCH term in arch's notation).\n","            q: Lag order of the lagged volatility (the GARCH term in arch's notation).\n","            vol_model: One of \"GARCH\", \"EGARCH\" or \"GJR-GARCH\".\n","\n","        Returns:\n","            The fitted ``ARCHModelResult``, also stored as ``self.model``.\n","\n","        Raises:\n","            ValueError: If ``vol_model`` is not recognised.\n","        \"\"\"\n","        if vol_model == \"GARCH\":\n","            spec = arch_model(self.data, p=p, q=q, vol=\"GARCH\", rescale=False)\n","        elif vol_model == \"EGARCH\":\n","            spec = arch_model(self.data, p=p, o=1, q=q, vol=\"EGARCH\", rescale=False)\n","        elif vol_model == \"GJR-GARCH\":\n","            spec = arch_model(self.data, o=1, p=p, q=q, vol=\"GARCH\", rescale=False)\n","        else:\n","            raise ValueError(f\"Unknown vol_model: {vol_model}\")\n","\n","        self.vol_model = vol_model\n","        self.model = spec.fit(disp=0)\n","        return self.model"]},{"cell_type":"code","execution_count":27,"id":"86e73d42","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:07.660485Z","iopub.status.busy":"2026-10-22T17:50:07.660058Z","iopub.status.idle":"2026-10-22T17:50:07.730314Z","shell.execute_reply":"2026-10-22T17:50:07.729417Z"},"papermill":{"duration":0.096238,"end_time":"2026-10-22T17:50:07.732178+00:00","exception":false,"start_time":"2026-10-22T17:50:07.63594+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["GARCH params: ['mu', 'omega', 'alpha[1]', 'beta[1]']\n"]}],"source":["# Check that each specification returns the expected parameters\n","gm_test = GarchModel(ticker=\"AAPL\", data=train_returns[\"AAPL\"])\n","gm_test.fit(p=1, q=1, vol_model=\"GARCH\")\n","\n","assert hasattr(gm_test, \"model\")\n","assert isinstance(gm_test.model, ARCHModelResult)\n","assert gm_test.model.params.index.tolist() == [\"mu\", \"omega\", \"alpha[1]\", \"beta[1]\"]\n","\n","print(\"GARCH params:\", gm_test.model.params.index.tolist())"]},{"c