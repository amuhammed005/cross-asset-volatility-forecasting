ol_model: One of \"GARCH\", \"EGARCH\" or \"GJR-GARCH\".\n","\n","    Returns:\n","        Persistence value.\n","    \"\"\"\n","    params = model_result.params\n","    if vol_model == \"GARCH\":\n","        return params[\"alpha[1]\"] + params[\"beta[1]\"]\n","    elif vol_model == \"GJR-GARCH\":\n","        return params[\"alpha[1]\"] + params[\"beta[1]\"] + 0.5 * params[\"gamma[1]\"]\n","    elif vol_model == \"EGARCH\":\n","        return params[\"beta[1]\"]"]},{"cell_type":"code","execution_count":36,"id":"6e293ce1","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:08.826347Z","iopub.status.busy":"2026-10-22T17:50:08.825493Z","iopub.status.idle":"2026-10-22T17:50:08.848552Z","shell.execute_reply":"2026-10-22T17:50:08.847789Z"},"papermill":{"duration":0.04992,"end_time":"2026-10-22T17:50:08.850263+00:00","exception":false,"start_time":"2026-10-22T17:50:08.800343+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>ticker</th>\n","      <th>asset_class</th>\n","      <th>vol_model</th>\n","      <th>aic</th>\n","      <th>bic</th>\n","      <th>log_likelihood</th>\n","      <th>persistence</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>1</th>\n","      <td>AAPL</td>\n","      <td>equity</td>\n","      <td>EGARCH</td>\n","      <td>3887.825970</td>\n","      <td>3912.379724</td>\n","      <td>-1938.912985</td>\n","      <td>0.950425</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>AAPL</td>\n","      <td>equity</td>\n","      <td>GJR-GARCH</td>\n","      <td>3889.59121