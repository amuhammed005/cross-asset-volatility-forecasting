_returns, predicted_variance):\n","    \"\"\"QLIKE loss between actual squared returns and predicted variance.\"\"\"\n","    return np.mean(np.log(predicted_variance) + (actual_sq_returns / predicted_variance))\n","\n","\n","eval_rows = []\n","for ticker in all_tickers:\n","    asset_class = \"equity\" if ticker in equity_tickers else \"crypto\"\n","    actual = test_returns[ticker].loc[wfv_predictions[ticker][\"GARCH\"].index]\n","    actual_sq = actual ** 2\n","\n","    for vol_model in vol_models:\n","        pred_vol = wfv_predictions[ticker][vol_model]\n","        pred_var = pred_vol ** 2\n","\n","        rmse = np.sqrt(np.mean((actual.abs() - pred_vol) ** 2))\n","        qlike = qlike_loss(actual_sq, pred_var)\n","\n","        eval_rows.append({\n","            \"ticker\": ticker,\n","            \"asset_class\": asset_class,\n","            \"vol_model\": vol_model,\n","            \"rmse\": rmse,\n","            \"qlike\": qlike,\n","        })\n","\n","wfv_comparison_df = pd.DataFrame(eval_rows)\n","wfv_comparison_df.sort_values([\"ticker\", \"qlike\"])"]},{"cell_type":"markdown","id":"be1ac4bd","metadata":{"papermill":{"duration":0.036112,"end_time":"2026-10-02T15:06:05.786861+00:00","exception":false,"start_time":"2026-10-02T15:06:05.750749+00:00","status":"completed"},"tags":[]},"source":["### In-Sample Best vs Out-of-Sample Best\n","\n","Directly answers Research Question 3: does the model with the best AIC also produce the best\n","out-of-sample forecasts?"]},{"cell_type":"code","execution_count":47,"id":"2d7918fc","metadata":{"execution":{"iopub.execute_input":"2026-10-02T15:06:05.864429Z","iopub.status.busy":"2026-10-02T15:06:05.86389Z","iopub.status.idle":"2026-10-02T15:06:05.882247Z","shell.execute_reply":"2026-10-02T15:06:05.880804Z"},"papermill":{"duration":0.058316,"end_time":"2026-10-02T15:06:05.884703+00:00","exception":false,"start_time":"2026-10-02T15:06:05.826387+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div