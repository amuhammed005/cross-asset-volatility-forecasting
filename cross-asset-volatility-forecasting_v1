"2026-10-02T15:02:37.918444+00:00","exception":false,"start_time":"2026-10-02T15:02:37.907142+00:00","status":"completed"},"tags":[]},"source":["## Stage 2: Data Storage\n","\n","**Goal:** store the collected equity and cryptocurrency data in a shared SQLite database, one table per\n","asset, so downstream stages can read the data back without repeatedly calling the API."]},{"cell_type":"code","execution_count":9,"id":"7c201d93","metadata":{"execution":{"iopub.execute_input":"2026-10-02T15:02:37.94583Z","iopub.status.busy":"2026-10-02T15:02:37.945257Z","iopub.status.idle":"2026-10-02T15:02:37.954082Z","shell.execute_reply":"2026-10-02T15:02:37.952768Z"},"papermill":{"duration":0.026262,"end_time":"2026-10-02T15:02:37.956061+00:00","exception":false,"start_time":"2026-10-02T15:02:37.929799+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# SQLRepository Class\n","# Handles all database transactions: connecting, inserting a DataFrame as a table, and reading a table back. One class, reused for every asset regardless of class (equity or crypto).\n","\n","class SQLRepository:\n","    \"\"\"Handles storage and retrieval of asset data in a SQLite database.\"\"\"\n","\n","    def __init__(self, connection: sqlite3.Connection):\n","        self.connection = connection\n","\n","    def insert_table(self, table_name: str, records: pd.DataFrame, if_exists: str = \"fail\") -> dict:\n","        \"\"\"Insert a DataFrame into the database as a table.\n","\n","        Parameters\n","        ----------\n","        table_name : str\n","        records : pd.DataFrame\n","        if_exists : str, optional\n","            \"fail\", \"replace\", or \"append\". By default \"fail\".\n","\n","        Returns\n","        -------\n","        dict\n","            Keys: \"transaction_successful\" (bool), \"records_inserted\" (int).\n","        \"\"\"\n","        n_inserted = records.to_sql(\n","            name=table_name, con=self.connection, if_exists=if_exists\n","        )\n","        return {\n","            \"transaction_successful\": True,\n","            \"records_inserted\": n_inserted,\n","        }\n","\n","    def read_table(self, table_name: str, limit: int = None) -> pd.DataFrame:\n","        \"\"\"Read a table from the database.\n","\n","        Parameters\n","        ----------\n","        table_name : str\n","        limit : int, None, optional\n","            Number of most recent records to retrieve. By default None (all records).\n","\n","        Returns\n","        -------\n","        pd.DataFrame\n","            Index is a DatetimeIndex named \"date\". Columns are\n","            \"open\", \"high\", \"low\", \"close\", \"volume\".\n","        \"\"\"\n","        if limit:\n","            sql = f'SELECT * FROM \"{table_name}\" ORDER BY date DESC LIMIT {limit}'\n","        else:\n","            sql = f'SELECT * FROM \"{table_name}\"'\n","\n","        df = pd.read_sql(sql=sql, con=self.connection, parse_dates=[\"date\"], index_col=\"date\")\n","        return df"]},{"cell_type":"code","execution_count":10,"id":"8f84fa8d","metadata":{"execution":{"iopub.execute_input":"2026-10-02T15:02:37.983801Z","iopub.status.busy":"2026-10-02T15:02:37.983335Z","iopub.status.idle":"2026-10-02T15:02:37.991349Z","shell.execute_reply":"2026-10-02T15:02:37.989995Z"},"papermill":{"duration":0.024298,"end_time":"2026-10-02T15:02:37.993557+00:00","exception":false,"start_time":"2026-10-02T15:02:37.969259+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["repo type: <class '__main__.SQLRepository'>\n"]}],"source":["# Confirm the repository connects correctly before using it at scale.\n","\n","connection = sqlite3.connect(database=\"volatility.sqlite\", check_same_thread=False)\n","repo = SQLRepository(connection=connection)\n","\n","assert hasattr(repo, \"connection\")\n","assert isinstance(repo.connection, sqlite3.Connection)\n","\n","print(\"repo type:\", type(repo))"]},{"cell_type":"markdown","id":"e14c3fe8","metadata":{"papermill":{"duration":0.013231,"end_time":"2026-10-02T15:02:38.020269+00:00","exception":false,"start_time":"2026-10-02T15:02:38.007038+00:00","status":"completed"},"tags":[]},"source":["### Insert All Assets\n","\n","Each asset gets its own table, named after its ticker. `if_exists=\"replace\"` keeps this notebook\n","re-runnable without duplicating rows."]},{"cell_type":"code","execution_count":11,"id":"e97e1075","metadata":{"execution":{"iopub.execute_input":"2026-10-02T15:02:38.047481Z","iopub.status.busy":"2026-10-02T15:02:38.047065Z","iopub.status.idle":"2026-10-02T15:02:38.440926Z","shell.execute_reply":"2026-10-02T15:02:38.439752Z"},"papermill":{"duration":0.411184,"end_time":"2026-10-02T15:02:38.443205+00:00","exception":false,"start_time":"2026-10-02T15:02:38.032021+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["AAPL: {'transaction_successful': True, 'records_inserted': 1255}\n","JPM: {'transaction_successful': True, 'records_inserted': 1255}\n","XOM: {'transaction_successful': True, 'records_inserted': 1255}\n","BTC-USD: {'transaction_successful': True, 'records_inserted': 1827}\n","ETH-USD: {'transaction_successful': True, 'records_inserted': 1827}\n","SOL-USD: {'transaction_successful': True, 'records_inserted': 1827}\n"]}],"source":["for ticker, df in all_data.items():\n","    response = repo.insert_table(table_name=ticker, records=df, if_exists=\"replace\")\n","    print(f\"{ticker}: {response}\")"]},{"cell_type":"code","execution_count":12,"id":"b3459d5e","metadata":{"execution":{"iopub.execute_input":"2026-10-02T15:02:38.471284Z","iopub.status.busy":"2026-10-02T15:02:38.470281Z","iopub.status.idle":"2026-10-02T15:02:38.496258Z","shell.execute_reply":"2026-10-02T15:02:38.494848Z"},"papermill":{"duration":0.041765,"end_time":"2026-10-02T15:02:38.498448+00:00","exception":false,"start_time":"2026-10-02T15:02:38.456683+00:00","status":"completed"},"tags":[]},"outputs":[{"nam