n","    std_resid = model_result.std_resid.dropna()\n","\n","    fig, axes = plt.subplots(1, 3, figsize=(18, 4))\n","\n","    std_resid.plot(ax=axes[0])\n","    axes[0].set_title(f\"{ticker} ({vol_model}): Standardized Residuals\")\n","    axes[0].set_xlabel(\"Date\")\n","\n","    axes[1].hist(std_resid, bins=25)\n","    axes[1].set_title(f\"{ticker} ({vol_model}): Residual Distribution\")\n","    axes[1].set_xlabel(\"Standardized Residual\")\n","    axes[1].set_ylabel(\"Frequency [count]\")\n","\n","    plot_acf(std_resid ** 2, ax=axes[2])\n","    axes[2].set_title(f\"{ticker} ({vol_model}): ACF of Squared Std. Residuals\")\n","    axes[2].set_xlabel(\"Lag [days]\")\n","    axes[2].set_ylabel(\"Correlation Coefficient\")\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","\n","# Diagnostics for each asset's best model by AIC\n","for ticker in all_tickers:\n","    best_vol_model = best_model_lookup[ticker]\n","    plot_diagnostics(fitted_models[ticker][best_vol_model].model, ticker, best_vol_model)"]},{"cell_type":"markdown","id":"8f7b6992","metadata":{"papermill":{"duration":0.032431,"end_time":"2026-10-22T17:50:12.770729+00:00","exception":false,"start_time":"2026-10-22T17:50:12.738298+00:00","status":"completed"},"tags":[]},"source":["## Step 8: Walk Forward Validation\n","All three specifications are evaluated out of sample with walk forward forecasting. The out of sample results are then compared with the in sample ranking by AIC to answer the third research question.\n","\n","**Walk forward forecasting.** At each step the model is refit using only the data available up to that day and produces a one day ahead volatility forecast. This mirrors real use and never looks at future data."]},{"cell_type":"code","execution_count":42,"id":"b02c728c","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:12.834247Z","iopub.status.busy":"2026-10-22T17:50:12.833904Z","iopub.status.idle":"2026-10-22T17:50:12.837922Z","shell.execute_reply":"2026-10-22T17:50:12.83716Z"},"papermill":{"duration":0.03824,"end_time":"2026-10-22T17:50:12.839526+00:00","exception":false,"start_time":"2026-10-22T17:50:12.801286+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# Walk forward validation refits every model at each day of the test period, so the full run\n","# (6 assets, 3 specifications, whole test window) takes tens of minutes. MAX_TEST_DAYS caps\n","# the window for quick runs, and None uses the full test set\n","MAX_TEST_DAYS = None"]},{"cell_type":"code","execution_count":43,"id":"70fb0f40","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:12.901351Z","iopub.status.busy":"2026-10-22T17:50:12.90102Z","iopub.status.idle":"2026-10-22T17:50:12.909107Z","shell.execute_reply":"2026-10-22T17:50:12.908213Z"},"papermill":{"duration":0.041421,"end_time":"2026-10-22T17:50:12.910856+00:00","exception":false,"start_time":"2026-10-22T17:50:12.869435+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def walk_forward_forecast(ticker, vol_model, p=1, q=1, max_test_days=None):\n","    \"\"\"Run walk forward, one day ahead volatility forecasting for one asset.\n","\n","    For each day of the test period the model is refit on all returns before that\n","    day and the next day's volatility is forecast. No future data is used.\n","\n","    Args:\n","        ticker: Asset ticker.\n","        vol_model: One of \"GARCH\", \"EGARCH\" or \"GJR-GARCH\".\n","        p: Lag order of the symmetric innovations.\n","        q: Lag order of the lagged volatility.\n","        max_test_days: If set, only the most recent ``max_test_days`` of the test\n","            period are forecast. None uses the full test period.\n","\n","    Returns:\n","        Series of predicted one day ahead volatility (standard deviation, not\n","        variance), indexed by date.\n","    \"\"\"\n","    full_returns = returns_data[ticker]\n","    test_index = test_returns[ticker].index\n","    if max_test_days:\n","        test_index = test_index[-max_test_days:]\n","    test_size = len(test_index)\n","\n","    predictions = []\n","    for i in range(test_size):\n","        window = full_returns.loc[:test_index[i]].iloc[:-1]\n","\n","        if vol_model == \"GARCH\":\n","            spec = arch_model(window, p=p, q=q, vol=\"GARCH\", rescale=False)\n","        elif vol_model == \"EGARCH\":\n","            spec = arch_model(window, p=p, o=1, q=q, vol=\"EGARCH\", rescale=False)\n","        elif vol_model == \"GJR-GARCH\":\n","            spec = arch_model(window, p=p, o=1, q=q, vol=\"GARCH\", rescale=False)\n","\n","        fitted = spec.fit(disp=0)\n","        next_pred = fitted.forecast(horizon=1, reindex=False).variance.iloc[0, 0] ** 0.5\n","        predictions.append(next_pred)\n","\n","    return pd.Series(predictions, index=test_index, name=\"predicted_volatility\")"]},{"cell_type":"code","execution_count":44,"id":"aced84d3","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:12.973467Z","iopub.status.busy":"2026-10-22T17:50:12.973114Z","iopub.status.idle":"2026-10-22T17:52:41.501468Z","shell.execute_reply":"2026-10-22T17:52:41.500476Z"},"papermill":{"duration":148.593149,"end_time":"2026-10-22T17:52:41.534206+00:00","exception":false,"start_time":"2026-10-22T17:50:12.941057+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["AAPL - GARCH: 251 forecasts\n","AAPL - EGARCH: 251 forecasts\n","AAPL - GJR-GARCH: 251 forecasts\n","JPM - GARCH: 251 forecasts\n","JPM - EGARCH: 251 forecasts\n","JPM - GJR-GARCH: 251 forecasts\n","XOM - GARCH: 251 forecasts\n","XOM - EGARCH: 251 forecasts\n","XOM - GJR-GARCH: 251 forecasts\n","BTC-USD - GARCH: 366 forecasts\n","BTC-USD - EGARCH: 366 forecasts\n","BTC-USD - GJR-GARCH: 366 forecasts\n","ETH-USD - GARCH: 366 forecasts\n","ETH-USD - EGARCH: 366 forecasts\n","ETH-USD - GJR-GARCH: 366 forecasts\n","SOL-USD - GARCH: 366 forecasts\n","SOL-USD - EGARCH: 366 forecasts\n","SOL-USD - GJR-GARCH: 366 forecasts\n"]}],"source":["# Walk forward forecasts for every asset and specification\n","wfv_predictions = {}\n","\n","for ticker in all_tickers:\n","    wfv_predictions[ticker] = {}\n","    for vol_model in vol_models:\n","        wfv_predictions[ticker][vol_model] = walk_forward_forecast(\n","            ticker=ticker, vol_model=vol_model, max_test_days=MAX_TEST_DAYS\n","        )\n","        print(f\"{ticker} - {vol_model}: {wfv_predictions[ticker][vol_model].shape[0]} forecasts\")"]},{"cell_type":"code","execution_count":45,"id":"a73d3cd1","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:52:41.59847Z","iopub.status.busy":"2026-10-22T17:52:41.597923Z","iopub.status.idle":"2026-10-22T17:52:41.605628Z","shell.execute_reply":"2026-10-22T17:52:41.604539Z"},"papermill":{"duration":0.042383,"end_time":"2026-10-22T17:52:41.607278+00:00","exception":false,"start_time":"2026-10-22T17:52:41.564895+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["All walk-forward forecasts validated.\n"]}],"source":["# Validate the forecast series\n","for ticker in all_tickers:\n","    for vol_model in vol_models:\n","        s = wfv_predictions[ticker][vol_model]\n","        assert isinstance(s, pd.Series)\n","        assert isinstance(s.index, pd.DatetimeIndex)\n","        assert s.isnull().sum() == 0\n","\n","print(\"All walk-forward forecasts validated.\")"]},{"cell_type":"markdown","id":"50db0dd3","metadata":{"papermill":{"duration":0.030923,"end_time":"2026-10-22T17:52:41.669329+00:00","exception":false,"start_time":"2026-10-22T17:52:41.638406+00:00","status":"completed"},"tags":[]},"source":["**Evaluation metrics.** Two metrics score the forecasts. RMSE compares the forecast volatility with the absolute test return. QLIKE compares the forecast variance with the squared test return, and it is a standard loss in the volatility forecasting literature because it penalises under prediction of variance more heavily, which matters