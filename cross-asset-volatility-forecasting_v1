>1.991011</td>\n","    </tr>\n","    <tr>\n","      <th>8</th>\n","      <td>XOM</td>\n","      <td>equity</td>\n","      <td>GJR-GARCH</td>\n","      <td>1.113006</td>\n","      <td>1.994636</td>\n","    </tr>\n","    <tr>\n","      <th>6</th>\n","      <td>XOM</td>\n","      <td>equity</td>\n","      <td>GARCH</td>\n","      <td>1.112652</td>\n","      <td>1.995739</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["     ticker asset_class  vol_model      rmse     qlike\n","1      AAPL      equity     EGARCH  1.164886  1.796723\n","0      AAPL      equity      GARCH  1.178094  1.810744\n","2      AAPL      equity  GJR-GARCH  1.193603  1.823457\n","11  BTC-USD      crypto  GJR-GARCH  1.845055  2.565151\n","10  BTC-USD      crypto     EGARCH  1.846211  2.580245\n","9   BTC-USD      crypto      GARCH  1.862300  2.581587\n","13  ETH-USD      crypto     EGARCH  2.593010  3.301856\n","14  ETH-USD      crypto  GJR-GARCH  2.608200  3.324867\n","12  ETH-USD      crypto      GARCH  2.632152  3.353070\n","3       JPM      equity      GARCH  1.022490  1.680686\n","4       JPM      equity     EGARCH  1.049201  1.697262\n","5       JPM      equity  GJR-GARCH  1.042899  1.701323\n","17  SOL-USD      crypto  GJR-GARCH  2.717460  3.413572\n","16  SOL-USD      crypto     EGARCH  2.712766  3.415304\n","15  SOL-USD      crypto      GARCH  2.726501  3.419044\n","7       XOM      equity     EGARCH  1.117438  1.991011\n","8       XOM      equity  GJR-GARCH  1.113006  1.994636\n","6       XOM      equity      GARCH  1.112652  1.995739"]},"execution_count":46,"metadata":{},"output_type":"execute_result"}],"source":["def qlike_loss(actual_sq_returns, predicted_variance):\n","    \"\"\"QLIKE loss between squared returns and forecast variance.\n","\n","    Lower is better. The loss penalises under prediction of variance more than\n","    over prediction.\n","\n","    Args:\n","        actual_sq_returns: Squared returns used as the variance proxy.\n","        predicted_variance: Forecast variance.\n","\n","    Returns:\n","        Mean QLIKE loss.\n","    \"\"\"\n","    return np.mean(np.log(predicted_variance) + (actual_sq_returns / predicted_variance))\n","\n","\n","# Forecast accuracy per asset and specification\n","eval_rows = []\n","for ticker in all_tickers:\n","    asset_class = \"equity\" if ticker in equity_tickers else \"crypto\"\n","    actual = test_returns[ticker].loc[wfv_predictions[ticker][\"GARCH\"].index]\n","    actual_sq = actual ** 2\n","\n","    for vol_model in vol_models:\n","        pred_vol = wfv_predictions[ticker][vol_model]\n","        pred_var = pred_vol ** 2\n","\n","        rmse = np.sqrt(np.mean((actual.abs() - pred_vol) ** 2))\n","        qlike = qlike_loss(actual_sq, pred_var)\n","\n","        eval_rows.append({\n","            \"ticker\": ticker,\n","            \"asset_class\": asset_class,\n","            \"vol_model\": vol_model,\n","            \"rmse\": rmse,\n","            \"qlike\": qlike,\n","        })\n","\n","wfv_comparison_df = pd.DataFrame(eval_rows)\n","wfv_comparison_df.sort_values([\"ticker\", \"qlike\"])"]},{"cell_type":"code","execution_count":47,"id":"ca9f51c3","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:52:41.828394Z","iopub.status.busy":"2026-10-22T17:52:41.828051Z","iopub.status.idle":"2026-10-22T17:52:41.84272Z","shell.execute_reply":"2026-10-22T17:52:41.841786Z"},"papermill":{"duration":0.049858,"end_time":"2026-10-22T17:52:41.844468+00:00","exception":false,"start_time":"2026-10-22T17:52:41.79461+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n",