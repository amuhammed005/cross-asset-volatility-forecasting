verged\n","BTC-USD - GJR-GARCH: converged\n","ETH-USD - GARCH: converged\n","ETH-USD - EGARCH: converged\n","ETH-USD - GJR-GARCH: converged\n","SOL-USD - GARCH: converged\n","SOL-USD - EGARCH: converged\n","SOL-USD - GJR-GARCH: converged\n"]}],"source":["# Fit every specification on every asset (18 models)\n","vol_models = [\"GARCH\", \"EGARCH\", \"GJR-GARCH\"]\n","fitted_models = {}\n","\n","for ticker in all_tickers:\n","    fitted_models[ticker] = {}\n","    for vol_model in vol_models:\n","        gm = GarchModel(ticker=ticker, data=train_returns[ticker])\n","        gm.fit(p=1, q=1, vol_model=vol_model)\n","        fitted_models[ticker][vol_model] = gm\n","        print(f\"{ticker} - {vol_model}: converged\")"]},{"cell_type":"code","execution_count":30,"id":"49ad0e1a","metadata":{"execution":{"iopub.execute_input":"2026-10-22T17:50:08.400335Z","iopub.status.busy":"2026-10-22T17:50:08.399914Z","iopub.status.idle":"2026-10-22T17:50:08.406247Z","shell.execute_reply":"2026-10-22T17:50:08.405335Z"},"papermill":{"duration":0.03273,"end_time":"2026-10-22T17:50:08.408074+00:00","exception":false,"start_time":"2026-10-22T17:50:08.375344+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["{'AAPL': {'GARCH': <__main__.GarchModel at 0x78cd85b02180>,\n","  'EGARCH': <__main__.GarchModel at 0x78cd85e04380>,\n","  'GJR-GARCH': <__main__.GarchModel at 0x78cd85d91fd0>},\n"," 'JPM': {'GARCH': <__main__.GarchModel at 0x78cd87c172c0>,\n","  'EGARCH': <__main__.GarchModel at 0x78cd85c6bcb0>,\n","  'GJR-GARCH': <__main__.GarchModel at 0x78cd863da120>},\n"," 'XOM': {'GARCH': <__main__.GarchModel at 0x78cd85b01b50>,\n","  'EGARCH': <__main__.GarchModel at 0x78cd85d33e30>,\n","  'GJR-GARCH': <__main__.GarchModel at 0x78cd85e5b6e0>},\n"," 'BTC-USD': {'GARCH': <__main__.GarchModel at 0x78cd85b03380>,\n","  'EGARCH': <__main__.GarchModel at 0x78cd861e5ee0>,\n","  'GJR-GARCH': <__main__.GarchModel at 0x78cd85b303b0>},\n"," 'ETH-USD': {'GARCH': <__main__.GarchModel at